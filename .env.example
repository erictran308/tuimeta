# Optional overrides, for development only: release builds ignore .env.
# Copy to .env in the repository's root: development builds read only that
# one, wherever they're run from.

# Where your login sessions, downloads and settings are kept.
# Default: the platform's app data directory (see `tuimeta --help`).
# A relative path is taken from where you run tuimeta; on Windows it must be
# an absolute path inside your user folder.
# TM_DATA_DIR=./.tuimeta

# The helper to run, when it isn't next to the tuimeta binary. Only an
# absolute path is taken.
# TM_HELPER=/path/to/tuimeta/target/debug/tuimeta-helper
