# Optional overrides, for development only: release builds ignore .env.
# Copy to .env in the directory you run from.

# Where your login sessions, downloads and settings are kept.
# Default: the platform's app data directory (see `tuimeta --help`).
# TM_DATA_DIR=./.tuimeta

# The helper to run, when it isn't next to the tuimeta binary.
# TM_HELPER=./target/debug/tuimeta-helper
